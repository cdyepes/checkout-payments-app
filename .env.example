# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- API ---
PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://checkout:checkout@localhost:5432/checkout?schema=public"
CORS_ORIGIN="http://localhost:5173"

