# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- API ---
PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://checkout:checkout@localhost:5432/checkout?schema=public"
CORS_ORIGIN="http://localhost:5173"

# Payment provider (sandbox). Values only — never rename these to the provider's name.
# Register at the provider's merchant portal to get your own sandbox key quartet.
PAYMENTS_API_URL="https://sandbox.wompi.co/v1"
PAYMENTS_PUBLIC_KEY="pub_test_..."
PAYMENTS_PRIVATE_KEY="prv_test_..."
PAYMENTS_INTEGRITY_KEY="test_integrity_..."
PAYMENTS_EVENTS_KEY="test_events_..."

# --- Web ---
VITE_API_BASE_URL="http://localhost:3000"
VITE_PAYMENTS_PUBLIC_KEY=""
