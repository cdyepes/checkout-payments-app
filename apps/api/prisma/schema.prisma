generator client {
  provider = "prisma-client-js"
  // Cloud Run runs the exact image we build (no separate runtime base image
  // the way Lambda's Docker packaging worked), so the build machine's
  // "native" engine target is already correct for production — no
  // cross-platform binaryTargets needed.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String
  imageUrl      String
  priceInCents  Int
  currency      String   @default("COP")
  stock         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactionItems TransactionItem[]

  @@map("products")
}

model Customer {
  id        String   @id @default(uuid())
  email     String
  fullName  String
  phone     String
  legalId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  deliveries   Delivery[]

  @@map("customers")
}

enum TransactionStatus {
  PENDING
  APPROVED
  DECLINED
  ERROR
  VOIDED
}

model Transaction {
  id                     String            @id @default(uuid())
  reference              String            @unique
  status                 TransactionStatus @default(PENDING)

  customerId             String
  customer               Customer          @relation(fields: [customerId], references: [id])

  items                  TransactionItem[]

  productAmountInCents   Int
  baseFeeInCents         Int
  deliveryFeeInCents     Int
  totalAmountInCents     Int
  currency               String            @default("COP")

  providerTransactionId  String?
  providerStatus         String?
  failureReason          String?

  delivery               Delivery?

  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@map("transactions")
}

model TransactionItem {
  id               String      @id @default(uuid())

  transactionId    String
  transaction      Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  productId        String
  product          Product     @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  quantity         Int
  unitPriceInCents Int
  subtotalInCents  Int

  createdAt        DateTime    @default(now())

  @@unique([transactionId, productId])
  @@index([productId])
  @@map("transaction_items")
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  DELIVERED
}

model Delivery {
  id                String         @id @default(uuid())
  transactionId     String         @unique
  transaction       Transaction    @relation(fields: [transactionId], references: [id])
  customerId        String
  customer          Customer       @relation(fields: [customerId], references: [id])

  addressLine       String
  city              String
  region            String
  country           String
  postalCode        String?

  feeInCents        Int
  status            DeliveryStatus @default(PENDING)

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("deliveries")
}
