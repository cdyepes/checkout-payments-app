generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; "rhel-openssl-3.0.x" is the correct target for
  // AWS Lambda's Node.js runtime (Amazon Linux 2023 / OpenSSL 3.0) — the build
  // image (Debian) and the Lambda runtime image differ, so relying on "native"
  // resolution alone would bundle the wrong engine binary for production.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String
  imageUrl      String
  priceInCents  Int
  currency      String   @default("COP")
  stock         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions  Transaction[]

  @@map("products")
}

model Customer {
  id        String   @id @default(uuid())
  email     String
  fullName  String
  phone     String
  legalId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  deliveries   Delivery[]

  @@map("customers")
}

enum TransactionStatus {
  PENDING
  APPROVED
  DECLINED
  ERROR
  VOIDED
}

model Transaction {
  id                     String            @id @default(uuid())
  reference              String            @unique
  status                 TransactionStatus @default(PENDING)

  productId              String
  product                Product           @relation(fields: [productId], references: [id])
  customerId             String
  customer               Customer          @relation(fields: [customerId], references: [id])

  quantity               Int
  productAmountInCents   Int
  baseFeeInCents         Int
  deliveryFeeInCents     Int
  totalAmountInCents     Int
  currency               String            @default("COP")

  providerTransactionId  String?
  providerStatus         String?
  failureReason          String?

  delivery               Delivery?

  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@map("transactions")
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  DELIVERED
}

model Delivery {
  id                String         @id @default(uuid())
  transactionId     String         @unique
  transaction       Transaction    @relation(fields: [transactionId], references: [id])
  customerId        String
  customer          Customer       @relation(fields: [customerId], references: [id])

  addressLine       String
  city              String
  region            String
  country           String
  postalCode        String?

  feeInCents        Int
  status            DeliveryStatus @default(PENDING)
  assignedProductId String?
  quantity          Int

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("deliveries")
}
